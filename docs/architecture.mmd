%% EzyShop Big Data prototype: Lambda architecture (render: make diagram)
flowchart LR
  subgraph SRC["SOURCES"]
    G1["Generator: clicks<br/>(semi-structured JSON)"]
    G2["Generator: orders<br/>(nested JSON)"]
    G3["Generator: reviews<br/>(free text)"]
    PG[("PostgreSQL 16<br/>system of record<br/>products · inventory<br/>suppliers · campaigns · orders")]
  end

  subgraph ING["INGESTION"]
    K[["Apache Kafka 3.8 (KRaft)<br/>topics: clicks · orders · reviews<br/>3 partitions, key = customer_pid"]]
  end

  subgraph PROC["PROCESSING · Apache Spark 3.5"]
    SP["SPEED LAYER<br/>Structured Streaming<br/>watermark 10 min · dedup<br/>1-min windows · VADER"]
    BA["BATCH LAYER (nightly)<br/>bronze → silver → gold<br/>VADER sentiment · MLlib GBT/LR forecast<br/>at-risk · OPTIMIZE / Z-ORDER"]
  end

  subgraph LAKE["DATA LAKE · S3 object storage (SeaweedFS locally)"]
    BR[("bronze<br/>raw events<br/>+ _quarantine")]
    SI[("silver<br/>deduped · typed<br/>joined to products")]
    GO[("gold<br/>sales · sentiment<br/>features · forecast<br/>at-risk · reorder")]
  end

  subgraph SERVE["SERVING"]
    M[("MongoDB 7<br/>live_metrics · live_sentiment<br/>forecasts · reorder_alerts<br/>review_sentiment · at_risk<br/>pipeline_metrics")]
  end

  subgraph USERS["USERS"]
    D["Streamlit dashboard<br/>Marketing (live) · Operations<br/>Customers · Pipeline"]
  end

  G1 --> K
  G2 --> K
  G3 --> K
  K --> SP
  SP -- "Query A: append (txn-idempotent)" --> BR
  SP -- "Query B: bulk upsert on _id" --> M
  BR --> BA
  PG -- "JDBC snapshot (batch import / CDC)" --> BA
  BA --> SI --> GO
  BA -- "replace nightly" --> M
  M --> D

  X["CROSS-CUTTING: salted SHA-256 pseudonymisation at ingestion · GDPR erasure (DELETE + VACUUM, suppression list)<br/>checkpoints · Delta ACID · health checks · .env configuration · metrics listener"]

  classDef speed fill:#fdf1e8,stroke:#eb6834,color:#0b0b0b;
  classDef batch fill:#e8f6ef,stroke:#1baf7a,color:#0b0b0b;
  classDef store fill:#eef4fc,stroke:#2a78d6,color:#0b0b0b;
  classDef cross fill:#f0efec,stroke:#898781,color:#0b0b0b;
  class SP speed;
  class BA batch;
  class BR,SI,GO,M,PG store;
  class X cross;
