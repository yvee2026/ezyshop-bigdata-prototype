%% EzyShop Big Data prototype: Lambda architecture (render: make diagram)
%% Top to bottom so it stays readable at A4 page width; no nested groups (Mermaid
%% overlaps groups whose nodes link outside them).
%%{init: {"theme": "base", "flowchart": {"nodeSpacing": 36, "rankSpacing": 48, "padding": 14, "wrappingWidth": 460}, "themeVariables": {"primaryColor": "#ffffff", "primaryBorderColor": "#898781", "primaryTextColor": "#0b0b0b", "lineColor": "#52514e", "clusterBkg": "#f6f6f4", "clusterBorder": "#c3c2b7", "edgeLabelBackground": "#ffffff", "fontSize": "16px"}}}%%
flowchart TB
  subgraph SRC["SOURCES (generator)"]
    G1["<b>Clicks</b><br/>semi-structured JSON"]
    G2["<b>Orders</b><br/>nested JSON line items"]
    G3["<b>Reviews</b><br/>unstructured free text"]
  end
  PG[("<b>PostgreSQL 16</b><br/>system of record: products,<br/>inventory, suppliers, campaigns")]

  K[["<b>Apache Kafka 3.8 (KRaft)</b><br/>3 topics × 3 partitions, keyed by pseudonymised customer ID"]]

  SP["<b>Speed layer</b> · Spark Structured Streaming<br/>30 s trigger · 10-min watermark · dedup on event_id<br/>1-min windows per category · live VADER sentiment"]

  BR[("<b>Delta Lake: bronze</b><br/>raw events + quarantine (S3 object storage)")]

  BA["<b>Batch layer</b> · nightly Spark + MLlib<br/>dedup · explode orders · join products (JDBC)<br/>VADER sentiment · GBT/LR forecast · at-risk score<br/>OPTIMIZE / Z-ORDER"]

  SI[("<b>Delta Lake: silver</b><br/>clean, typed, joined")]
  GO[("<b>Delta Lake: gold</b><br/>sales · sentiment · forecast<br/>reorder · at-risk")]

  M[("<b>MongoDB 7</b> · serving store<br/>live metrics · live sentiment · forecasts<br/>reorder alerts · at-risk customers · pipeline metrics")]

  D["<b>Streamlit dashboard</b><br/>Marketing (live) · Operations · Customers · Pipeline"]

  X["<b>Cross-cutting, every layer</b><br/>salted SHA-256 pseudonyms at ingestion · GDPR erasure (DELETE + VACUUM, suppression list)<br/>checkpoints · idempotent sinks · health checks · .env configuration"]

  G1 --> K
  G2 --> K
  G3 --> K
  K --> SP
  SP -- "append raw events" --> BR
  SP -- "upsert 1-min windows" --> M
  BR -- "nightly read" --> BA
  PG -- "JDBC snapshot" --> BA
  BA -- "writes" --> SI
  BA -- "writes" --> GO
  BA -- "replace nightly results" --> M
  M --> D
  D ~~~ X

  classDef layer fill:#e8f0fb,stroke:#2a78d6,stroke-width:2px,color:#0b0b0b;
  classDef store fill:#ffffff,stroke:#898781,color:#0b0b0b;
  classDef cross fill:#f0efec,stroke:#898781,color:#0b0b0b;
  class SP,BA layer;
  class BR,SI,GO,M,PG store;
  class X cross;
