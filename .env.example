# EzyShop prototype configuration.
# Copy to .env (`cp .env.example .env`); `make up` does this automatically if .env is missing.
# These are LOCAL DEVELOPMENT values only. Change them for anything that is not your laptop.

# ---------- host ports (change if something on your machine already uses them) ----------
HOST_PORT_KAFKA=9094
HOST_PORT_S3=8333
HOST_PORT_S3_MASTER=9333
HOST_PORT_MONGO=27017
HOST_PORT_POSTGRES=15432
HOST_PORT_SPARK_UI=14040
HOST_PORT_DASHBOARD=8501

# ---------- Kafka ----------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_PARTITIONS=3
TOPIC_CLICKS=clicks
TOPIC_ORDERS=orders
TOPIC_REVIEWS=reviews

# ---------- object storage (S3-compatible; SeaweedFS stands in for MinIO/S3) ----------
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=ezyshop
S3_SECRET_KEY=ezyshop-local-secret
LAKE_BUCKET=ezyshop-lake

# ---------- MongoDB (serving store) ----------
MONGO_USER=ezyshop
MONGO_PASSWORD=ezyshop-local-mongo
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=ezyshop

# ---------- PostgreSQL (system of record) ----------
POSTGRES_USER=ezyshop
POSTGRES_PASSWORD=ezyshop-local-pg
POSTGRES_DB=ezyshop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- privacy ----------
# Salt for SHA-256 pseudonymisation of customer IDs. Keep secret in production.
PSEUDO_SALT=change-me-local-salt-7f3a

# ---------- generator ----------
EVENTS_PER_SEC=200
BURST_MULTIPLIER=10
NUM_CUSTOMERS=5000
RANDOM_SEED=42

# ---------- Spark ----------
SPARK_MASTER=local[3]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=6
WINDOW_MINUTES=1
WATERMARK_MINUTES=10
TRIGGER_SECONDS=30
MAX_OFFSETS_PER_TRIGGER=200000
